{
  "name": "frame-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Decision-first, agent-native project management system for git repositories",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elydelva/frame.git"
  },
  "packageManager": "bun@1.3.11",
  "workspaces": ["packages/*", "apps/*"],
  "overrides": {
    "ws": "^8.21.0"
  },
  "catalog": {
    "typescript": "^5.7.0",
    "@biomejs/biome": "^1.9.4",
    "bun-types": "^1.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10"
  },
  "scripts": {
    "build": "bun run --filter '@frame/core' build && bun run --filter './packages/fs' build && bun run --filter './packages/git' build && bun run --filter './packages/lint' build && bun run --filter '@frame/sdk' build && bun run --filter './apps/cli' build",
    "build:bin": "bun build apps/cli/src/index.ts --compile --outfile dist/frame --target bun",
    "test": "bun test --coverage && bun scripts/check-coverage.mjs",
    "test:watch": "bun test --watch",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check --write .",
    "typecheck": "tsc --noEmit --project tsconfig.base.json",
    "prepare": "husky",
    "clean": "bun run --filter './packages/*' clean && bun run --filter './apps/*' clean"
  },
  "devDependencies": {
    "@biomejs/biome": "catalog:",
    "bun-types": "catalog:",
    "husky": "catalog:",
    "lint-staged": "catalog:",
    "typescript": "catalog:"
  },
  "lint-staged": {
    "*.{ts,tsx}": "biome check --write"
  }
}
