{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    ".": {
      "entry": [],
      "project": ["packages/*/src/**/*.ts"]
    },
    "packages/*": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts"],
      "ignore": ["src/**/*.test.ts", "src/**/*.spec.ts"]
    }
  },
  "ignoreDependencies": [
    "bun-types",
    "typescript",
    "@frame/core",
    "@frame/fs",
    "@frame/git",
    "@frame/lint",
    "commander",
    "gray-matter",
    "js-yaml"
  ],
  "ignoreExportsUsedInFile": true
}
